{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8[1m]"
  },
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write",
      "Bash(pnpm typecheck)", "Bash(pnpm lint:*)", "Bash(pnpm test:*)",
      "Bash(pnpm test)", "Bash(pnpm build)",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git worktree:*)", "Bash(git switch:*)",
      "Task(test-author)", "Task(implementer)", "Task(reviewer)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(**/secrets/**)",
      "Bash(pnpm add:*)", "Bash(pnpm install:*)", "Bash(npm install:*)", "Bash(yarn add:*)",
      "Bash(git push * main)", "Bash(rm -rf:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read|Edit|Write|Bash|Grep|Glob", "hooks": [ { "type": "command", "command": "node .harness/guard.ts" } ] }
    ]
  },
  "attribution": {
    "pr": "---\n_Erstellt mit der agentischen Harness. Alle Änderungen wurden vor dem Merge menschlich geprüft und verantwortet._"
  }
}
