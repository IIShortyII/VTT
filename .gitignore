# Node
node_modules/
dist/

# Env
.env
.env.*
# Die Vorlage gehoert ins Repo, nur die ausgefuellten Dateien nicht.
!.env.example
*.local

# Claude Code: persoenliche lokale Overrides. Die Harness-Definitionen (agents/,
# skills/, commands/, settings.json) gehoeren dagegen ins Repo.
.claude/settings.local.json

# Harness-Laufzeitzustand (Run-State und Feature-Worktrees)
.harness/runs/
.harness/wt/

# SQLite-Dateien. Die Entwicklungs-DB (prisma/dev.db) ist lokaler Zustand und enthaelt echte
# Konten samt Passwort-Hashes; die Wegwerf-DB der Integrationstests (test.db) entsteht pro
# Lauf neu. Beides gehoert nie ins Repo - die Migrationen unter prisma/migrations/ dagegen
# schon, die sind der versionierte Teil.
*.db
*.db-journal
*.db-shm
*.db-wal

# OS / Crash-Artefakte
.DS_Store
*.stackdump

# Kartenbilder der Kartenbibliothek (map-library #49): lokale Ablage neben der DB,
# Pfad aus UPLOAD_DIR (Default ./data/uploads). Nutzerdaten, nie im Repo.
data/
