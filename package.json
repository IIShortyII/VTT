{
  "name": "vtt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern unit.test",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern integration.test",
    "test:harness": "jest -c .harness/jest.config.cjs",
    "harness": "tsx .harness/orchestrator.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@prisma/client": "^6",
    "fastify": "^5",
    "pixi.js": "^8",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.4",
    "socket.io": "^4",
    "socket.io-client": "^4",
    "zod": "^3"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^5",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "prettier": "^3",
    "prisma": "^6",
    "ts-jest": "^29",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7"
  }
}
