// Nur Datenquelle und Generator. Die Modelle entstehen mit den Changes, die sie brauchen —
// kein Schema auf Vorrat (constitution.md §1.1).
//
// SQLite: DATABASE_URL zeigt auf eine Datei. Die Entwicklungs-DB (dev.db) und die
// Wegwerf-DB der Integrationstests (test.db) sind getrennte Dateien; guard.ts laesst
// Migrationen des Agenten nur gegen letztere zu.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// user-auth (#12): Identitaet (User) und Anmeldeverfahren (Account) getrennt, damit ein
// zweiter Provider spaeter danebengelegt werden kann, statt User umzubauen. Siehe
// openspec/changes/add-user-auth/design.md D2.
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  // add-username-and-alias (#45): Anzeigename (wie eingegeben) getrennt vom
  // Einmaligkeits-Schluessel - SQLite kennt kein case-insensitives Unique fuer Unicode
  // (design.md D1). `usernameKey` wird ausschliesslich vom Server berechnet
  // (`server/auth/rules.ts`, `usernameKey()`), nie vom Client gesetzt.
  username    String
  usernameKey String       @unique
  createdAt   DateTime     @default(now())
  accounts    Account[]
  sessions    Session[]
  // game-session (#6): Gegenrelation zu den Mitgliedschaften - siehe design.md D2.
  memberships Membership[]
  // map-library (#49): Gegenrelation zu den eigenen Karten - siehe design.md D1.
  maps        GameMap[]
}

model Account {
  id           String @id @default(cuid())
  userId       String
  provider     String
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // account-security (#13): Fehlversuchszaehler und Sperrzeitpunkt je Konto (nicht je
  // Nutzer, D-alt D2: ein zweiter Provider bekaeme eigene Zaehler). Beide Spalten haben
  // Defaults bzw. sind nullable, damit die Migration bestehende Zeilen nicht anfasst
  // (design.md D1).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  @@unique([userId, provider])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// game-session (#6): der dauerhafte Raum einer Spielrunde. Nicht zu verwechseln mit
// `Session` oben (die Anmelde-Sitzung aus user-auth) - deshalb `GameSession`, in Prosa
// "Spielsitzung" (design.md D2, Requirement "Spielsitzung erstellen"). `status` ist ein
// String mit zod-Enum an der Grenze (`shared/session.ts`), kein Prisma-`enum` - die
// SQLite-Enum-Unterstuetzung ist ueber Prisma-Versionen hinweg nicht verlaesslich
// dokumentiert (design.md D2).
model GameSession {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  status      String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  // session-map (#50): eingehaengte Karteninstanzen (design.md D1) und der Zeiger auf die
  // aktive Instanz - "hoechstens eine aktive je Spielsitzung" ist damit eine Spalte, keine
  // Regel, die jeder Schreibpfad einhalten muss.
  instances        MapInstance[] @relation("SessionInstances")
  activeInstanceId String?       @unique
  activeInstance   MapInstance?  @relation("ActiveInstance", fields: [activeInstanceId], references: [id], onDelete: SetNull)
}

// game-session (#6): dauerhafte Zuordnung Nutzer <-> Spielsitzung mit Rolle. Rolle an der
// Mitgliedschaft, nicht am Nutzer - dieselbe Person leitet die eine Runde und spielt in der
// anderen (design.md D2). `@@unique([sessionId, userId])` erzwingt "hoechstens einmal
// Mitglied" in der DB, nicht im Code.
model Membership {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  role      String
  // add-username-and-alias (#45): Charaktername je Mitgliedschaft, nicht je Nutzer -
  // derselbe Nutzer spielt in zwei Spielsitzungen zwei Charaktere (design.md D4). `null` =
  // kein Alias, dann zeigt die Teilnehmerliste den Nutzernamen.
  alias     String?
  joinedAt  DateTime    @default(now())
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// map-library (#49): eine Karte der privaten Bibliothek eines Nutzers. `GameMap`, nicht
// `Map` - `Map` ist ein globaler JavaScript-Typ, ein generierter Prisma-Typ dieses Namens
// wuerde ihn in jedem Import ueberdecken (Muster wie `GameSession`, design.md D1). Raster
// als vier Spalten statt JSON - abfragbar, migrierbar, in einer DB-Aussage direkt pruefbar
// (design.md D1). `gridType`/`imageType` sind `String` mit zod-Enum an der Grenze
// (`shared/map.ts`), kein Prisma-`enum` (Muster wie `GameSession.status`). `imageFile`
// ist nullable - eine Karte ohne Bild ist ein gueltiger Zustand.
model GameMap {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  imageFile   String?
  imageType   String?
  gridType    String
  gridSize    Int
  gridOffsetX Int
  gridOffsetY Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // session-map (#50): Gegenrelation zu den Instanzen, in denen diese Karte eingehaengt ist.
  instances   MapInstance[]

  @@index([ownerId])
}

// session-map (#50): eine in eine Spielsitzung eingehaengte Bibliothekskarte (design.md D1).
// Raster und Bild bleiben an `GameMap` - diese Instanz ist ein Verweis mit eigener Identitaet,
// keine Kopie. Eine Karte ist je Spielsitzung hoechstens einmal eingehaengt
// (`@@unique([sessionId, mapId])`), dieselbe Karte darf in mehreren Spielsitzungen liegen.
// `onDelete: Cascade` an der Spielsitzung (eine geloeschte Spielsitzung nimmt ihre Instanzen
// mit), `onDelete: Restrict` an der Karte (Loeschsperre, design.md D6 - die Route prueft
// selbst und antwortet mit `409`; der Fremdschluessel ist nur der Rueckhalt).
model MapInstance {
  id        String      @id @default(cuid())
  sessionId String
  mapId     String
  position  Int
  createdAt DateTime    @default(now())
  session   GameSession @relation("SessionInstances", fields: [sessionId], references: [id], onDelete: Cascade)
  map       GameMap     @relation(fields: [mapId], references: [id], onDelete: Restrict)
  // Gegenrelation zum Zeiger `GameSession.activeInstance` - nicht-null genau dann, wenn diese
  // Instanz die aktive Karte ihrer Spielsitzung ist.
  activeIn  GameSession? @relation("ActiveInstance")

  @@unique([sessionId, mapId])
  @@index([mapId])
}
