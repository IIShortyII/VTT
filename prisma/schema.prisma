// Nur Datenquelle und Generator. Die Modelle entstehen mit den Changes, die sie brauchen —
// kein Schema auf Vorrat (constitution.md §1.1).
//
// SQLite: DATABASE_URL zeigt auf eine Datei. Die Entwicklungs-DB (dev.db) und die
// Wegwerf-DB der Integrationstests (test.db) sind getrennte Dateien; guard.ts laesst
// Migrationen des Agenten nur gegen letztere zu.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// user-auth (#12): Identitaet (User) und Anmeldeverfahren (Account) getrennt, damit ein
// zweiter Provider spaeter danebengelegt werden kann, statt User umzubauen. Siehe
// openspec/changes/add-user-auth/design.md D2.
model User {
  id          String       @id @default(cuid())
  email       String       @unique
  // add-username-and-alias (#45): Anzeigename (wie eingegeben) getrennt vom
  // Einmaligkeits-Schluessel - SQLite kennt kein case-insensitives Unique fuer Unicode
  // (design.md D1). `usernameKey` wird ausschliesslich vom Server berechnet
  // (`server/auth/rules.ts`, `usernameKey()`), nie vom Client gesetzt.
  username    String
  usernameKey String       @unique
  createdAt   DateTime     @default(now())
  accounts    Account[]
  sessions    Session[]
  // game-session (#6): Gegenrelation zu den Mitgliedschaften - siehe design.md D2.
  memberships Membership[]
  // map-library (#49): Gegenrelation zu den eigenen Karten - siehe design.md D1.
  maps        GameMap[]
  // add-token-assignment (#15): Gegenrelation zu den Tokens, deren Besitzer dieser Nutzer
  // ist - siehe design.md D1.
  tokens      Token[]
  // add-token-sharing (#62): Gegenrelation zu den Zielgruppen-Zeilen, in denen dieser Nutzer
  // als Empfaenger steht - siehe design.md D1.
  tokenShares TokenShare[]
}

model Account {
  id           String @id @default(cuid())
  userId       String
  provider     String
  passwordHash String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // account-security (#13): Fehlversuchszaehler und Sperrzeitpunkt je Konto (nicht je
  // Nutzer, D-alt D2: ein zweiter Provider bekaeme eigene Zaehler). Beide Spalten haben
  // Defaults bzw. sind nullable, damit die Migration bestehende Zeilen nicht anfasst
  // (design.md D1).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  @@unique([userId, provider])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// game-session (#6): der dauerhafte Raum einer Spielrunde. Nicht zu verwechseln mit
// `Session` oben (die Anmelde-Sitzung aus user-auth) - deshalb `GameSession`, in Prosa
// "Spielsitzung" (design.md D2, Requirement "Spielsitzung erstellen"). `status` ist ein
// String mit zod-Enum an der Grenze (`shared/session.ts`), kein Prisma-`enum` - die
// SQLite-Enum-Unterstuetzung ist ueber Prisma-Versionen hinweg nicht verlaesslich
// dokumentiert (design.md D2).
model GameSession {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  status      String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  // session-map (#50): eingehaengte Karteninstanzen (design.md D1) und der Zeiger auf die
  // aktive Instanz - "hoechstens eine aktive je Spielsitzung" ist damit eine Spalte, keine
  // Regel, die jeder Schreibpfad einhalten muss.
  instances        MapInstance[] @relation("SessionInstances")
  activeInstanceId String?       @unique
  activeInstance   MapInstance?  @relation("ActiveInstance", fields: [activeInstanceId], references: [id], onDelete: SetNull)
}

// game-session (#6): dauerhafte Zuordnung Nutzer <-> Spielsitzung mit Rolle. Rolle an der
// Mitgliedschaft, nicht am Nutzer - dieselbe Person leitet die eine Runde und spielt in der
// anderen (design.md D2). `@@unique([sessionId, userId])` erzwingt "hoechstens einmal
// Mitglied" in der DB, nicht im Code.
model Membership {
  id        String      @id @default(cuid())
  sessionId String
  userId    String
  role      String
  // add-username-and-alias (#45): Charaktername je Mitgliedschaft, nicht je Nutzer -
  // derselbe Nutzer spielt in zwei Spielsitzungen zwei Charaktere (design.md D4). `null` =
  // kein Alias, dann zeigt die Teilnehmerliste den Nutzernamen.
  alias     String?
  joinedAt  DateTime    @default(now())
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// map-library (#49): eine Karte der privaten Bibliothek eines Nutzers. `GameMap`, nicht
// `Map` - `Map` ist ein globaler JavaScript-Typ, ein generierter Prisma-Typ dieses Namens
// wuerde ihn in jedem Import ueberdecken (Muster wie `GameSession`, design.md D1). Raster
// als vier Spalten statt JSON - abfragbar, migrierbar, in einer DB-Aussage direkt pruefbar
// (design.md D1). `gridType`/`imageType` sind `String` mit zod-Enum an der Grenze
// (`shared/map.ts`), kein Prisma-`enum` (Muster wie `GameSession.status`). `imageFile`
// ist nullable - eine Karte ohne Bild ist ein gueltiger Zustand.
model GameMap {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  imageFile   String?
  imageType   String?
  gridType    String
  gridSize    Int
  gridOffsetX Int
  gridOffsetY Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // session-map (#50): Gegenrelation zu den Instanzen, in denen diese Karte eingehaengt ist.
  instances   MapInstance[]

  @@index([ownerId])
}

// session-map (#50): eine in eine Spielsitzung eingehaengte Bibliothekskarte (design.md D1).
// Raster und Bild bleiben an `GameMap` - diese Instanz ist ein Verweis mit eigener Identitaet,
// keine Kopie. Eine Karte ist je Spielsitzung hoechstens einmal eingehaengt
// (`@@unique([sessionId, mapId])`), dieselbe Karte darf in mehreren Spielsitzungen liegen.
// `onDelete: Cascade` an der Spielsitzung (eine geloeschte Spielsitzung nimmt ihre Instanzen
// mit), `onDelete: Restrict` an der Karte (Loeschsperre, design.md D6 - die Route prueft
// selbst und antwortet mit `409`; der Fremdschluessel ist nur der Rueckhalt).
// add-fog-of-war (#16): `fogVersion` ist der Cache-Schluessel des maskierten Bilds und das
// Signal fuer einen Spieler-Client, das Bild neu zu laden (design.md D1) - waechst nur, wenn
// sich die aufgedeckten Zellen (`FogCell`) aendern, nicht bei einer Bereichsaenderung.
// `fogCells`/`fogAreas` sind die Gegenrelationen; Aushaengen der Instanz loescht beide per
// Cascade.
model MapInstance {
  id         String      @id @default(cuid())
  sessionId  String
  mapId      String
  position   Int
  fogVersion Int         @default(0)
  createdAt  DateTime    @default(now())
  session    GameSession @relation("SessionInstances", fields: [sessionId], references: [id], onDelete: Cascade)
  map        GameMap     @relation(fields: [mapId], references: [id], onDelete: Restrict)
  // Gegenrelation zum Zeiger `GameSession.activeInstance` - nicht-null genau dann, wenn diese
  // Instanz die aktive Karte ihrer Spielsitzung ist.
  activeIn   GameSession? @relation("ActiveInstance")
  // session-token (#14): Gegenrelation zu den Tokens dieser Instanz - siehe design.md D1.
  tokens     Token[]
  // add-fog-of-war (#16): Gegenrelation zu den aufgedeckten Zellen und den Bereichen dieser
  // Instanz - siehe design.md D1.
  fogCells   FogCell[]
  fogAreas   FogArea[]

  @@unique([sessionId, mapId])
  @@index([mapId])
}

// session-token (#14): eine Figur auf einer Karteninstanz (design.md D1). Haengt an der
// Instanz, nicht an der Spielsitzung - ein Kartenwechsel behaelt die Tokens, ein Aushaengen
// nimmt sie mit (`onDelete: Cascade`). `icon` speichert den Katalogeintrag selbst (das
// Emoji), geprueft durch `TokenIconSchema` an der Grenze (`shared/token.ts`); `col`/`row`
// sind die Ankerzelle, kein Pixel - Einrasten ist damit eine Eigenschaft des Modells.
// add-token-assignment (#15): `ownerId` ist ein nullabler Verweis auf `User` - `null` heisst
// "gehoert dem Spielleiter" (design.md D1). `onDelete: SetNull`, weil ein geloeschter Nutzer
// ein besitzerloses Token hinterlassen soll, kein geloeschtes.
// add-token-stats (#61): fuenf nullable Wertespalten (design.md D1) - `null` heisst "nicht
// gesetzt" (proposal.md), kein Default ausser `null`. `conditions` ist die Gegenrelation zu
// `TokenCondition` (Tabelle statt JSON - SQLite kennt kein `Json`, design.md D1).
// add-token-sharing (#62): `shares` ist die Gegenrelation zu `TokenShare` - je (Token, Stat)
// keine, eine oder mehrere Zeilen (design.md D1).
model Token {
  id         String           @id @default(cuid())
  instanceId String
  name       String
  color      String
  icon       String?
  size       Int
  col        Int
  row        Int
  ownerId    String?
  hp         Int?
  hpMax      Int?
  tempHp     Int?
  ac         Int?
  initiative Int?
  createdAt  DateTime         @default(now())
  instance   MapInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  owner      User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  conditions TokenCondition[]
  shares     TokenShare[]

  @@index([instanceId])
  @@index([ownerId])
}

// add-token-stats (#61): eine Markierung (Kurztext) an einem Token, geordnet nach `position`
// (design.md D1). Tabelle statt JSON-String, damit "je Token eindeutig" eine
// Datenbank-Eigenschaft ist (`@@unique([tokenId, label])`), nicht eine Regel, die jeder
// Schreibpfad selbst einhalten muss (Muster "Raster als vier Spalten statt JSON", #49 D1).
// `onDelete: Cascade` - ein entferntes Token nimmt seine Markierungen mit.
model TokenCondition {
  id       String @id @default(cuid())
  tokenId  String
  label    String
  position Int
  token    Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, label])
  @@index([tokenId])
}

// add-token-sharing (#62): wer einen Stat eines Tokens zusaetzlich zu Spielleiter und
// Besitzer sieht (design.md D1). Eine Zeile je Empfaenger: `keine` = keine Zeile fuer
// (Token, Stat); `alle` = genau eine Zeile mit `userId` `null`; eine Liste = eine Zeile je
// `userId`. `stat` ist `String` mit zod-Enum an der Grenze (`shared/token.ts`,
// `TokenStatSchema`), kein Prisma-`enum` (Muster wie `GameSession.status`).
// `@@unique([tokenId, stat, userId])` verhindert doppelte Empfaenger auf DB-Ebene; SQLite
// behandelt `NULL` im Unique-Index als je verschieden - `toToken` liest defensiv ("alle"
// gewinnt, siehe design.md D3). `onDelete: Cascade` an beiden Fremdschluesseln: ein
// entferntes Token oder ein geloeschter Nutzer nimmt seine Zielgruppen-Zeilen mit.
model TokenShare {
  id      String  @id @default(cuid())
  tokenId String
  stat    String
  userId  String?
  token   Token   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenId, stat, userId])
  @@index([tokenId])
  @@index([userId])
}

// add-fog-of-war (#16): eine aufgedeckte Zelle einer Karteninstanz (design.md D1) - eine
// Zeile je Zelle, `@@unique([instanceId, col, row])` macht "keine Zelle doppelt" zu einer
// Datenbankeigenschaft (Muster `TokenCondition`, #61 D1). `onDelete: Cascade` - Aushaengen
// der Instanz loescht die aufgedeckten Zellen mit.
model FogCell {
  id         String      @id @default(cuid())
  instanceId String
  col        Int
  row        Int
  instance   MapInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, col, row])
}

// add-fog-of-war (#16): ein benannter, gespeicherter Bereich einer Karteninstanz (design.md
// D1) - eine Vorbereitung des Spielleiters, die aufgedeckten Zellen bleiben die einzige
// Wahrheit ("revealed" ist abgeleitet, keine Spalte hier). `onDelete: Cascade` von der
// Instanz - Aushaengen loescht die Bereiche mit.
model FogArea {
  id         String        @id @default(cuid())
  instanceId String
  name       String
  createdAt  DateTime      @default(now())
  instance   MapInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  cells      FogAreaCell[]

  @@index([instanceId])
}

// add-fog-of-war (#16): die Zellen eines Bereichs (design.md D1) - eine Zeile je Zelle,
// `@@unique([areaId, col, row])` macht "keine Zelle doppelt je Bereich" zu einer
// Datenbankeigenschaft. `onDelete: Cascade` - ein geloeschter Bereich nimmt seine Zellen mit.
model FogAreaCell {
  id     String  @id @default(cuid())
  areaId String
  col    Int
  row    Int
  area   FogArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([areaId, col, row])
}
