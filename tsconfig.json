{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext gilt projektweit - auch fuer den Frontend-Code. Die ".js"-Suffixe in
    // relativen Imports sind damit Pflicht; nicht auf "bundler" umstellen, ohne den
    // Server-Code mitzudenken.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", ".harness/**/*.ts"],
  "exclude": ["node_modules", "dist", ".harness/wt", ".harness/runs"]
}
