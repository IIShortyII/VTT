{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext gilt projektweit. Frontend-Code ergaenzt hier "jsx": "react-jsx" und
    // "DOM"/"DOM.Iterable" in "lib" - beides bewusst nicht vorbelegt (stack-neutral).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", ".harness/**/*.ts"],
  "exclude": ["node_modules", "dist", ".harness/wt", ".harness/runs"]
}
